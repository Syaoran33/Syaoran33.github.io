# Store LF in the repository and check out LF, so Windows line-ending
# conversion does not rewrite every file of the vendored theme on upgrade.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.pdf binary
